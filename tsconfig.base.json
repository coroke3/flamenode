{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@flamenode/contracts": ["./packages/contracts/src/index.ts"],
      "@flamenode/db": ["./packages/db/src/schema/index.ts"],
      "@flamenode/db/*": ["./packages/db/src/*"],
      "@flamenode/domain": ["./packages/domain/src/index.ts"],
      "@flamenode/domain/*": ["./packages/domain/src/*"],
      "@flamenode/server-core": ["./packages/server-core/src/index.ts"],
      "@flamenode/server-core/*": ["./packages/server-core/src/*"],
      "@flamenode/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
