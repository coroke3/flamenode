{
  "name": "flamenode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#utils/delimited": "./src/lib/utils/delimited.ts",
    "#utils/next": "./src/lib/utils/next.ts",
    "#utils/url": "./src/lib/utils/url.ts",
    "#utils/xid": "./src/lib/utils/xid.ts",
    "#utils/event-status-core": "./src/lib/utils/eventStatusCore.ts",
    "#utils/clipboard-html": "./src/lib/utils/clipboardHtml.ts",
    "#spreadsheet/constants": "./src/lib/admin/spreadsheet/constants.ts",
    "#spreadsheet/cellFormat": "./src/lib/admin/spreadsheet/cellFormat.ts",
    "#spreadsheet/validation": "./src/lib/admin/spreadsheet/validation.ts",
    "#spreadsheet/paste": "./src/lib/admin/spreadsheet/paste.ts"
  },
  "description": "FlameNode - 個人制作映像とイベントをつなぐ動画プラットフォーム。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node -r ./scripts/load-dev-vars.cjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:local": "node -r ./scripts/load-dev-vars.cjs node_modules/next/dist/bin/next dev",
    "clean:next": "node scripts/clean-next-cache.cjs",
    "dev:clean": "node scripts/stop-dev-ports.cjs && node scripts/clean-next-cache.cjs && node -r ./scripts/load-dev-vars.cjs node_modules/next/dist/bin/next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local-apply": "wrangler d1 migrations apply flamenode_db --local",
    "grant-admin": "node scripts/grant-admin.cjs",
    "check:db-legacy": "node scripts/check-db-legacy.mjs",
  "repair:video-event-links": "node scripts/repair-video-event-links.mjs",
  "repair:event-group-legacy": "node scripts/repair-event-group-legacy.mjs",
    "check:public-api-leaks": "node scripts/check-public-api-leaks.mjs",
    "check:cloudflare-config": "node scripts/check-cloudflare-config.mjs",
    "merge:dry-run": "node scripts/merge-dry-run.mjs",
    "test:workers": "node --test --experimental-strip-types workers/**/*.test.mjs",
    "test:notif": "node --test --experimental-strip-types src/lib/notifications/format.test.mjs",
    "test:youtube": "node --test --experimental-strip-types src/lib/youtube/id.test.mjs",
    "test:unit": "node --test --experimental-strip-types workers/**/*.test.mjs src/**/*.test.mjs",
    "test:static-rebuild": "node --test scripts/static-rebuild.test.mjs",
    "pages:build": "node scripts/run-next-on-pages.cjs && node scripts/pages-postbuild.mjs",
    "pages:dev": "npm run pages:build && wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat --d1=DB --r2=BUCKET --kv=KV",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name=flamenode",
    "workers:deploy": "node scripts/deploy-workers.mjs",
    "cf:bootstrap": "node scripts/cloudflare-bootstrap.mjs",
    "cf:sync-ids": "node scripts/sync-wrangler-ids.mjs",
    "preview": "npm run pages:dev"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "next": "15.1.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "typescript": "^5.7.3",
    "wrangler": "^4.92.0"
  }
}
