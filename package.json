{
  "name": "flamenode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#utils/delimited": "./src/lib/utils/delimited.ts",
    "#utils/next": "./src/lib/utils/next.ts",
    "#utils/url": "./src/lib/utils/url.ts",
    "#utils/xid": "./src/lib/utils/xid.ts",
    "#utils/event-status-core": "./src/lib/utils/eventStatusCore.ts",
    "#utils/clipboard-html": "./src/lib/utils/clipboardHtml.ts",
    "#spreadsheet/constants": "./src/lib/admin/spreadsheet/constants.ts",
    "#spreadsheet/cellFormat": "./src/lib/admin/spreadsheet/cellFormat.ts",
    "#spreadsheet/validation": "./src/lib/admin/spreadsheet/validation.ts",
    "#spreadsheet/paste": "./src/lib/admin/spreadsheet/paste.ts"
  },
  "overrides": {
    "workerd": "1.20260730.1",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.25"
    }
  },
  "description": "FlameNode - 個人制作映像とイベントをつなぐ動画プラットフォーム。",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node -r ./scripts/load-dev-vars.cjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:local": "node -r ./scripts/load-dev-vars.cjs node_modules/next/dist/bin/next dev",
    "clean:next": "node scripts/clean-next-cache.cjs",
    "generate:brand-assets": "node scripts/generate-brand-seo-assets.mjs",
    "dev:clean": "node scripts/stop-dev-ports.cjs && node scripts/clean-next-cache.cjs && node -r ./scripts/load-dev-vars.cjs node_modules/next/dist/bin/next dev",
    "db:studio": "drizzle-kit studio",
    "db:local-apply": "node scripts/apply-d1-migrations.mjs local",
    "db:remote-apply": "node scripts/apply-d1-migrations.mjs remote",
    "grant-admin": "node scripts/grant-admin.cjs",
    "check:db-legacy": "node scripts/check-db-legacy.mjs",
    "repair:video-event-links": "node scripts/repair-video-event-links.mjs",
    "check:public-api-contract": "node --experimental-strip-types scripts/check-public-api-contract.mts",
    "check:public-api-leaks": "node --experimental-strip-types scripts/check-public-api-leaks.mjs",
    "check:cloudflare-config": "node scripts/check-cloudflare-config.mjs",
    "check:cloudflare-template": "node scripts/check-cloudflare-template.mjs",
    "estimate:queue-budget": "node --experimental-strip-types scripts/estimate-queue-budget.mjs",
    "check:open-next-output": "node scripts/check-open-next-output.mjs",
    "check:db-schema": "node scripts/check-db-schema.mjs",
    "check:db-migration": "node scripts/check-db-canonical-migration.mjs",
    "check:event-owners": "node scripts/check-event-owners.mjs",
    "check:auth-orphan-users": "node scripts/check-auth-orphan-users.mjs",
    "check:event-owner-operability": "node scripts/check-event-owner-operability.mjs",
    "check:x-link-dependencies": "node scripts/check-x-link-dependencies.mjs",
    "check:audit-actor-x": "node scripts/check-audit-actor-x.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:db-history": "node scripts/check-db-change-history.mjs",
    "check:project-docs": "node scripts/check-project-docs.mjs",
    "check:ui-acceptance": "node scripts/check-ui-acceptance.mjs",
    "check:video-interactions-auth": "node scripts/check-video-interactions-auth.mjs",
    "verify:fast": "node scripts/cloudflare-verify-fast.mjs",
    "verify:cloud": "node scripts/cloudflare-verify-fast.mjs --cloud",
    "verify:full": "npm run verify:fast && npm run test:unit && npm run test:integration && npm run check:db-schema && npm run check:db-migration && npm run check:db-d1-empty && npm run check:db-d1-legacy && npm run check:db-legacy && npm run check:event-owners && npm run check:ui-acceptance && npm run check:public-api-contract && npm run check:docs && npm run check:db-history && npm run check:project-docs",
    "cf:build": "node scripts/cloudflare-build.mjs",
    "cf:deploy-production": "node scripts/cloudflare-deploy-production.mjs",
    "cf:smoke-production": "node scripts/smoke-cloudflare.mjs",
    "cf:cloud-build": "npm run verify:cloud && npm run cf:build",
    "cf:preflight": "npm run verify:full && npm run cf:build",
    "cf:verify-deploy": "npm run cf:preflight",
    "merge:dry-run": "node scripts/merge-dry-run.mjs",
    "test:workers": "node --test --experimental-strip-types workers/**/*.test.mjs",
    "test:critical": "node --test --experimental-strip-types app/api/health/route.test.mjs src/lib/health/deepHealth.test.mjs src/lib/api/eventExportAuthorization.contract.test.mjs src/lib/api/publicApi.test.mjs src/lib/api/publicSlotsPage.contract.test.mjs src/lib/auth/accountLinkAdapter.execution.test.mjs src/lib/auth/authFlowTrace.contract.test.mjs src/lib/auth/origin.test.mjs src/lib/auth/ownership.test.mjs src/lib/auth/permissions/permissionResolver.test.mjs src/lib/auth/routeApiSecurity.contract.test.mjs src/lib/auth/runtimeAuth.contract.test.mjs src/lib/auth/serverActionAvailability.contract.test.mjs src/lib/auth/writeGuardCore.test.mjs src/lib/auth/xIdLifecycle.contract.test.mjs src/lib/auth/xIdUserFlow.contract.test.mjs src/lib/staticRebuild/liveApiCore.test.mjs src/lib/actions/cost-guard.contract.test.mjs src/lib/operationMode/noAutoCostGuard.contract.test.mjs src/lib/slots/batchGenerateCount.test.mjs src/lib/slot/reservationSubject.contract.test.mjs src/lib/slot/reservationGroupsCore.test.mjs src/lib/actions/slotIntegrity.contract.test.mjs src/lib/actions/slotIntegrity.execution.test.mjs src/lib/video/videoVisibilityTransition.test.mjs src/components/video/VideoStatusForm.contract.test.mjs",
    "test:notif": "node --test --experimental-strip-types src/lib/notifications/format.test.mjs",
    "test:youtube": "node --test --experimental-strip-types src/lib/youtube/id.test.mjs",
    "test:unit": "node --test --experimental-strip-types src/**/*.test.mjs",
    "test:integration": "node --test --experimental-strip-types src/**/*.integration.test.mjs",
    "test:cloudflare-ci": "node --test scripts/cloudflare-ci.test.mjs scripts/d1-migration-compat.test.mjs",
    "test:static-rebuild": "node --test scripts/static-rebuild.test.mjs src/lib/staticRebuild/*.test.mjs",
    "check:static-rebuild-atomicity": "node scripts/check-static-rebuild-atomicity.mjs",
    "check:artifact-slo": "node scripts/check-artifact-slo.mjs",
    "check:public-visibility-fences": "node scripts/check-public-visibility-fences.mjs",
    "check:moderation-open-cases": "node scripts/check-moderation-open-cases.mjs",
    "check:slot-reservation-groups": "node scripts/check-slot-reservation-groups.mjs",
    "check:slot-domain-limits": "node scripts/check-slot-domain-limits.mjs",
    "backfill:slot-reservation-groups": "node scripts/backfill-slot-reservation-groups.mjs",
    "cf:bootstrap": "node scripts/cloudflare-bootstrap.mjs",
    "preview": "node scripts/cloudflare-preview.mjs",
    "wrangler:types": "wrangler types",
    "check:db-d1-empty": "node scripts/check-db-d1-migration.mjs empty",
    "check:db-d1-legacy": "node scripts/check-db-d1-migration.mjs legacy"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@next/third-parties": "15.5.22",
    "@opennextjs/cloudflare": "1.20.2",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.22",
    "sharp": "0.35.3",
    "typescript": "^5.7.3",
    "wrangler": "4.118.0"
  }
}
