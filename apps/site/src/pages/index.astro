---
/**
 * `/` (MIG-0506 / Recipe R-PAGE / Runtime S0): the whole top page as static HTML from the `top` and `trending`
 * build snapshots. The loop/auto-scroll behaviour of the shelves is the MIG-0507 Island; native horizontal scroll
 * works without it. The page title is the bare site name (CURRENT `title.absolute`).
 */
import { TopView } from "@flamenode/ui";
import PublicLayout from "../layouts/PublicLayout.astro";
import { DEFAULT_SITE_DESCRIPTION, SITE_NAME, buildPageHead, siteOrigin } from "../lib/pageHead.ts";
import { loadTopForBuild } from "../lib/topData.ts";

const head = { ...buildPageHead({ path: "/", title: SITE_NAME, description: DEFAULT_SITE_DESCRIPTION }), title: SITE_NAME };
const view = await loadTopForBuild();
// CURRENT `websiteJsonLd` of `app/(public)/page.tsx` (WebSite + SearchAction).
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: `${siteOrigin()}/`,
  description: DEFAULT_SITE_DESCRIPTION,
  inLanguage: "ja",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${siteOrigin()}/list?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
---
<PublicLayout head={head} currentPath="/" jsonLd={[websiteJsonLd]}>
  <TopView {...view} />
</PublicLayout>
