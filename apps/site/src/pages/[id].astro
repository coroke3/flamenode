---
/**
 * Representative Video Detail SSG Page (MIG-0403 / Recipe R-PAGE / Runtime S0).
 * Pre-renders public video detail HTML with full OGP and Island hydration.
 * Private and deleted fixtures are strictly excluded at build time.
 */
import { VideoDetailView, type VideoDetailData } from "@flamenode/ui";
import { IslandWrapper } from "../components/IslandWrapper.ts";
import { getPublicRepresentativeVideos } from "../lib/representativeFixtures.ts";
import type { VideoPublicSnapshot } from "../lib/publicDataLoader.ts";

export async function getStaticPaths() {
  const videos = getPublicRepresentativeVideos();
  return videos.map((video) => ({
    params: { id: video.id },
    props: { video },
  }));
}

interface Props {
  video: VideoPublicSnapshot;
}

const { video } = Astro.props;
const title = `${video.title} - FlameNode`;
const canonicalUrl = video.canonicalUrl ?? `https://flamenode.net/${video.id}`;
const ogImageUrl = video.ogImageUrl ?? video.thumbnailUrl ?? "https://flamenode.net/brand/ogp-default.png";
const description = video.description ?? "";

const videoData: VideoDetailData = {
  id: video.id,
  title: video.title,
  creator: {
    name: video.creatorName ?? "FlameNode Creator",
    xUserId: video.creatorHandle ? video.creatorHandle.replace(/^@/, "") : null,
    iconUrl: video.creatorAvatarUrl ?? null,
    profileHref: video.creatorHandle ? `/user/${video.creatorHandle.replace(/^@/, "")}` : null,
  },
  publishedLabel: video.publishedAt ? new Date(video.publishedAt).toLocaleDateString("ja-JP") : null,
  thumbnailUrl: video.thumbnailUrl ?? null,
  hasYoutube: Boolean(video.youtubeVideoId),
  introComment: video.description ?? null,
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="video.other" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="FlameNode" />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
  </head>
  <body>
    <IslandWrapper client:load>
      <VideoDetailView video={videoData} />
    </IslandWrapper>
  </body>
</html>
