{
  "name": "flamenode",
  "version": "0.1.0",
  "private": true,
  "description": "FlameNode - 映像（フレーム）の結節点（ノード）。YouTube埋め込みを利用した動画プラットフォーム。",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:local": "node -r ./scripts/load-dev-vars.js node_modules/next/dist/bin/next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local-apply": "wrangler d1 migrations apply flamenode_db --local",
    "grant-admin": "node scripts/grant-admin.cjs",
    "check:db-legacy": "node scripts/check-db-legacy.mjs",
    "check:public-api-leaks": "node scripts/check-public-api-leaks.mjs",
    "pages:build": "next-on-pages",
    "pages:dev": "next-on-pages && wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat --d1=DB --r2=BUCKET --kv=KV",
    "preview": "wrangler pages dev"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "drizzle-orm": "^0.36.4",
    "next": "15.1.6",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "typescript": "^5.7.3",
    "wrangler": "^3.99.0"
  }
}
