---
/**
 * `/user/[id]` (MIG-0504 / Recipe R-PAGE / Runtime S0). One static page per creator that has a published,
 * manifest-allowed profile snapshot; banned / merged / unapproved / private creators get no page (gateway 404).
 * Page 1 of works and collabs is static HTML; `?worksPage=` / `?collabPage=` are applied by the Island.
 */
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { CreatorProfileIsland } from "../../../components/CreatorProfileIsland.ts";
import { serializeJsonLd } from "../../../lib/pageHead.ts";
import { loadUserBuildData, type UserBuildEntry } from "../../../lib/userData.ts";
import {
  STATIC_USER_COLLABS_PAGE_SIZE,
  STATIC_USER_WORKS_PAGE_SIZE,
  USER_COLLAB_DISPLAY_PAGE_SIZE,
  USER_WORKS_DISPLAY_PAGE_SIZE,
  buildCreatorHeader,
  buildPersonJsonLd,
  buildProfileHead,
  buildSectionPages,
} from "../../../lib/userViews.ts";

export async function getStaticPaths() {
  const data = await loadUserBuildData();
  return [...data.users].map(([id, entry]) => ({ params: { id }, props: { entry } }));
}

interface Props {
  entry: UserBuildEntry;
}

const { profile, worksPages, collabsPages } = Astro.props.entry;
const head = buildProfileHead(profile);
const header = buildCreatorHeader(profile);
const works = buildSectionPages(profile.works, worksPages, USER_WORKS_DISPLAY_PAGE_SIZE, STATIC_USER_WORKS_PAGE_SIZE);
const collabs = buildSectionPages(profile.collabs, collabsPages, USER_COLLAB_DISPLAY_PAGE_SIZE, STATIC_USER_COLLABS_PAGE_SIZE);
const jsonLd = buildPersonJsonLd(profile);
---
<PublicLayout head={head} currentPath="/user">
  <script slot="head" is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>
  <CreatorProfileIsland client:load header={header} works={works} collabs={collabs} />
</PublicLayout>
