---
/**
 * `/user/[id]/portfolio` (MIG-0504 / Recipe R-PAGE / Runtime S0). Fully static, noindex like CURRENT.
 * Shows the first 36 works of the profile snapshot (CURRENT `WORK_LIMIT`); non-public works are already
 * dropped by the CURRENT normalizer. Same emission rule as `/user/[id]`: no profile snapshot, no page.
 */
import { PortfolioView, type PortfolioData } from "@flamenode/ui";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { loadUserBuildData, type UserBuildEntry } from "../../../lib/userData.ts";
import { loadPublicXIconMapForBuild, portfolioIconUrl } from "../../../lib/publicIconMap.ts";
import { resolveProjectedIcon, type PublicXIconEntry } from "../../../../../../src/lib/publicData/publicIconProjection.ts";
import {
  PORTFOLIO_WORK_LIMIT,
  buildCreatorHeader,
  buildPortfolioHead,
  toScreenVideoCard,
} from "../../../lib/userViews.ts";

export async function getStaticPaths() {
  const [data, iconMap] = await Promise.all([loadUserBuildData(), loadPublicXIconMapForBuild()]);
  return [...data.users].map(([id, entry]) => ({ params: { id }, props: { entry, iconMap } }));
}

interface Props {
  entry: UserBuildEntry;
  iconMap: ReadonlyMap<string, PublicXIconEntry>;
}

const { profile } = Astro.props.entry;
const { iconMap } = Astro.props;
const head = buildPortfolioHead(profile, iconMap);
const header = buildCreatorHeader(profile);
const works = profile.works.items.slice(0, PORTFOLIO_WORK_LIMIT).map((v) =>
  toScreenVideoCard({
    ...v,
    icon_url: resolveProjectedIcon({
      xUserId: v.creator_x_user_id,
      iconMap,
      legacyIconUrl: v.icon_url,
    }),
  }),
);
const portfolio: PortfolioData = {
  id: header.id,
  name: header.name,
  iconUrl: portfolioIconUrl(profile.user, iconMap),
  youtubeChannelUrl: header.youtubeChannelUrl,
  socialLinks: header.socialLinks,
  profileText: header.profileText,
  contact: header.contact,
  works,
  totalWorks: profile.works.total,
  workLimit: PORTFOLIO_WORK_LIMIT,
};
---
<PublicLayout head={head} currentPath="/user">
  <PortfolioView portfolio={portfolio} />
</PublicLayout>
