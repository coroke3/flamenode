# Auth.js
AUTH_SECRET="please-generate-a-strong-random-string"
# 独立した32文字以上のランダム値をローカル.dev.varsだけへ設定する
SPREADSHEET_IMPORT_PREVIEW_SECRET=""
AUTH_TRUST_HOST="true"
# OAuth のリダイレクト組み立てに必須 (未設定だと signIn で Invalid URL)
# ポートを変えた場合はここも合わせる (例: http://localhost:3001)
AUTH_URL="http://localhost:3000"

# Discord OAuth
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_BOT_TOKEN=""
DISCORD_WEBHOOK_URL=""

# YouTube Data API
YOUTUBE_API_KEY=""
# Google Cloud Consoleで設定した1日quota。FlameNodeはこの80%を上限に使う。
YOUTUBE_DAILY_QUOTA_LIMIT="10000"

# 公開設定
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="FlameNode"
NEXT_PUBLIC_SITE_DESCRIPTION="映像作品とクリエイター、イベントをつなぐ動画プラットフォーム。"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# sync-jobs (runtime; set on Worker vars/secrets, not necessarily web)
# GA4_SYNC_ENABLED=0
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_EMAIL=
# GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# メンテナンス強制 (1 で全ページを /maintenance へ。本番は Worker Runtime Variables で設定)
MAINTENANCE_MODE="0"

# 公開 JSON を R2 のみで配信 (1/true/yes で D1 を読まず static_only 相当)
FORCE_STATIC_ONLY="0"

# R2 取得失敗後の bounded D1 フォールバック (0 で停止。未設定時は有効)
PUBLIC_DEGRADED_D1_ENABLED="1"

# Cloudflare Queues feature flags (Phase 1: disabled by default)
QUEUE_DISPATCH_ENABLED="0"
QUEUE_CONTINUATION_ENABLED="0"
QUEUE_YOUTUBE_SYNC_ENABLED="0"

# 管理画面: D1 スプレッドシート (/admin/spreadsheet)。本番では原則 false
ADMIN_SPREADSHEET_ENABLED="true"
# 1ページあたりの取得行数（未設定時は 500、上限 5000）
ADMIN_SPREADSHEET_PAGE_SIZE="500"
