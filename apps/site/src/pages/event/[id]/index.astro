---
/**
 * `/event/[id]` (MIG-0403 representative -> MIG-0502 U02 / Recipe R-PAGE / Runtime S0).
 * One page per public event in the build data; private, deleted or unreadable events produce no file.
 * The page body, head and Event JSON-LD come from the build; clock-dependent labels and slot counts are
 * refreshed by the Island (live slot state is never in the static HTML).
 */
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { EventDetailIsland } from "../../../components/EventDetailIsland.ts";
import { getEventBuildData } from "../../../lib/eventData.ts";
import { buildEventJsonLd } from "../../../lib/eventDetail.ts";
import { buildPageHead, serializeJsonLd } from "../../../lib/pageHead.ts";
import type { StaticEventDetail } from "../../../../../src/lib/publicData/staticEventDetailCore.ts";

export async function getStaticPaths() {
  const { details } = await getEventBuildData();
  return [...details.values()].map((detail) => ({ params: { id: detail.event.id }, props: { detail } }));
}

interface Props {
  detail: StaticEventDetail;
}

const { detail } = Astro.props;
const { event } = detail;
const head = buildPageHead({
  path: `/event/${event.id}`,
  title: event.title,
  description: event.explanation,
  image: event.img_url ?? event.icon_url,
});
const builtAt = Math.floor(Date.now() / 1000);
---
<PublicLayout head={head} currentPath="/event">
  <script slot="head" is:inline type="application/ld+json" set:html={serializeJsonLd(buildEventJsonLd(event))}></script>
  <EventDetailIsland client:load detail={detail} builtAt={builtAt} />
</PublicLayout>
