---
/**
 * `/maintenance` (MIG-0501 U02 / D-13-27): keep MIG-0619's gateway-safe
 * static body and CURRENT noindex, but render under the normal public shell.
 * Gateway maintenance bypass and status semantics remain unchanged.
 */
import { MaintenanceView } from "@flamenode/ui";
import PublicLayout from "../layouts/PublicLayout.astro";
import { StaticScreen } from "../components/StaticScreen.ts";
import { buildPageHead } from "../lib/pageHead.ts";

const head = buildPageHead({ path: "/maintenance", title: "メンテナンス中", noIndex: true });
---
<PublicLayout head={head} currentPath="/maintenance">
  <StaticScreen screen={MaintenanceView} props={{}} />
</PublicLayout>
