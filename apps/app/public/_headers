# MIG-0620: Personal SPA (Vite assetsDir=_personal_assets) の hash 付き bundle。
# index.html など HTML には rule を置かない。
/_personal_assets/*
  Cache-Control: public, max-age=31536000, immutable

# MIG-0701 (D-13-8): CURRENT (auth) is force-dynamic; never cache private SPA HTML.
/dashboard
  Cache-Control: private, no-cache, no-store, max-age=0, must-revalidate

/dashboard/*
  Cache-Control: private, no-cache, no-store, max-age=0, must-revalidate

/onboarding
  Cache-Control: private, no-cache, no-store, max-age=0, must-revalidate
