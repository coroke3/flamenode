---
/**
 * `/about` (MIG-0501 / Recipe R-PAGE / Runtime S0). Static HTML, no request-time data.
 * Stats: the Phase 4 snapshot loader has no stats object, so none are passed and the block stays
 * hidden, the same as CURRENT when its client fetch fails (see the MIG-0501 work item).
 */
import { AboutView } from "@flamenode/ui";
import PublicLayout from "../layouts/PublicLayout.astro";
import { buildPageHead } from "../lib/pageHead.ts";

const head = buildPageHead({
  path: "/about",
  title: "FlameNode について",
  description:
    "FlameNode は、個人制作映像のアーカイブとイベント参加・投稿・運営の記録をつなぐサイトです。",
});
---
<PublicLayout head={head} currentPath="/about">
  <AboutView />
</PublicLayout>
