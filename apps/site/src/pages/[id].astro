---
/**
 * `/[id]` video catch-all (MIG-0507 / R-PAGE / S0): one static page per public video snapshot, at the YouTube id
 * and at the internal id (CURRENT serves both; canonical is the first). Fixed routes and assets win over these
 * slugs, and a collision fails the build (MIG-0404 route map). Only when the snapshot env is completely unset the
 * build uses the fixture videos (`videoFixtures.ts`: vid-aaa at its YouTube id and internal id, vid-bbb at its
 * internal id); a partly set env or a broken snapshot fails the build.
 * The page is `VideoPageIsland` (client:load): the player, like/save, chapter and comment controls are Islands;
 * until their APIs exist the static HTML shows the display of the view.
 */
import PublicLayout from "../layouts/PublicLayout.astro";
import { VideoPageIsland } from "../components/VideoPageIsland.ts";
import { gaMeasurementId } from "../lib/pageHead.ts";
import { loadVideoPagesForBuild, type VideoPage } from "../lib/videoPage.ts";

export async function getStaticPaths() {
  const pages = await loadVideoPagesForBuild();
  return pages.map((page) => ({ params: { id: page.slug }, props: { page } }));
}

interface Props {
  page: VideoPage;
}

const { page } = Astro.props;
const gaEnabled = gaMeasurementId() !== null;
---
<PublicLayout head={page.head} currentPath={`/${page.slug}`} jsonLd={page.jsonLd}>
  <VideoPageIsland client:load video={page.data} youtubeId={page.youtubeId} primaryEventId={page.data.primaryEvent?.id ?? null} gaEnabled={gaEnabled} />
</PublicLayout>
