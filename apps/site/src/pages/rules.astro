---
/**
 * `/rules` (MIG-0501 + MIG-0519 / Recipe R-PAGE / Runtime S0).
 * The terms are generated at build time; the consent form is mounted only
 * in the browser so JS-disabled visitors never see a dead submit button.
 * Production cutover is gated by MIG-0641 (API/CostGuard) and human approval.
 */
import { RulesView } from "@flamenode/ui";
import PublicLayout from "../layouts/PublicLayout.astro";
import { buildPageHead } from "../lib/pageHead.ts";
import { loadRulesForBuild, rulesSourceFromEnv } from "../lib/rulesLoader.ts";

const head = buildPageHead({
  path: "/rules",
  title: "利用規約",
  description: "FlameNodeの投稿・閲覧・イベント参加に関する利用規約です。",
});
const rules = await loadRulesForBuild(rulesSourceFromEnv());
---
<PublicLayout head={head} currentPath="/rules">
  <RulesView versionLabel={rules.versionLabel} updatedLabel={rules.updatedLabel} blocks={rules.blocks} showConsentMount={true} />
</PublicLayout>
<script>
  import { mountRulesConsent } from "../components/RulesConsentIsland.ts";
  mountRulesConsent();
</script>
